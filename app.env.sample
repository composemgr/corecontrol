# CoreControl environment configuration

# Timezone
TZ=America/New_York

# Hostname / domain
BASE_HOST_NAME=$HOSTNAME
BASE_DOMAIN_NAME=example.com

# Application secret (JWT)
APP_SECRET_KEY=changeme_secret_key_min_32_chars

# Database (PostgreSQL)
DB_CREATE_DATABASE_NAME=corecontrol
DB_ADMIN_NAME=postgres
DB_ADMIN_PASS=changeme_admin_password
